# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ==============================================================================
# Multi-Tenancy & Subdominios SaaS
# ==============================================================================
# Dominio base de la plataforma para resolver subdominios.
# En desarrollo local: localhost:3000
# En producción: tudominio.com (con registro DNS Wildcard *.tudominio.com)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# ==============================================================================
# Base de Datos (Opcional)
# ==============================================================================
# Si NO defines DATABASE_URL o POSTGRES_URL, la aplicación se autoconfigurará
# automáticamente utilizando SQLite (.data/blog.db) con auto-migración y
# auto-seeding de datos de prueba.
#
# Para conectar a PostgreSQL (Neon, Supabase, Railway, Vercel Postgres, Local):
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/yourblog
# o
# POSTGRES_URL=postgresql://usuario:contraseña@localhost:5432/yourblog

