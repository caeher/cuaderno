# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/panel
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/panel

# ==============================================================================
# Multi-Tenancy & Subdominios SaaS
# ==============================================================================
# Dominio base de la plataforma para resolver subdominios.
# En desarrollo local: localhost:3000
# En producción: tudominio.com (con registro DNS Wildcard *.tudominio.com)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# ==============================================================================
# Convex Backend & Auth
# ==============================================================================
# Deployment identifier generado por la CLI de Convex (dev:<nombre> o prod:<nombre>)
CONVEX_DEPLOYMENT=

# URL pública de Convex a la que se conecta el cliente Next.js (Browser & Server)
NEXT_PUBLIC_CONVEX_URL=

# URL de HTTP actions de Convex (generada automáticamente por npx convex dev)
NEXT_PUBLIC_CONVEX_SITE_URL=

# Dominio del Issuer de JWT de Clerk (usado en convex/auth.config.ts)
# En desarrollo: https://<tu-instancia>.clerk.accounts.dev
# En producción: https://clerk.<tudominio>.com o https://<tu-instancia-prod>.clerk.accounts.dev
# Nota: En Convex, esta variable se configura con: npx convex env set CLERK_JWT_ISSUER_DOMAIN <url>
CLERK_JWT_ISSUER_DOMAIN=

# Tras configurar Clerk, crea el JWT template "convex" (aud: convex):
#   pnpm setup:clerk-convex
# O en Clerk Dashboard → JWT Templates → New template → Convex

# ==============================================================================
# Audio Narration & TTS (Server-Only Configuration)
# ==============================================================================
# Clave privada de API de Vapi (solo accesible en servidor / Node.js)
VAPI_PRIVATE_API_KEY=

# URL base de la API de Vapi (por defecto https://api.vapi.ai)
VAPI_API_BASE_URL=https://api.vapi.ai

# Configuración global de voz y asistente para narraciones
VAPI_DEFAULT_VOICE_ID=sarah
VAPI_DEFAULT_VOICE_PROVIDER=11labs
VAPI_DEFAULT_AUDIO_FORMAT=mp3
VAPI_ASSISTANT_NAME=Blog Narration Voice
VAPI_DEFAULT_LANGUAGE=es

# Feature Flag y Kill Switch Operativo (deshabilita narraciones sin redesplegar código)
ENABLE_VAPI_NARRATIONS=true
NEXT_PUBLIC_ENABLE_AUDIO_NARRATION=true
AUDIO_NARRATION_KILL_SWITCH=false

